{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["@algorandfoundation/algorand-typescript"]
  },
  "include": ["contracts/**/*.algo.ts"],
  "exclude": ["node_modules"]
}
